+            memset(p, 0, partial_plane * sizeof(float));
+
+            if (t0 >= T) {
+                continue;
+            }
+
+            for (int64_t t = t0; t < t1; ++t) {
+                for (int64_t g = 0; g < Hkv; ++g) {
+                    const char * v_row = (const char *) v->data + s*nb13 + t*nb11 + g*nb12;
+                    to_float(v_row, v32, D);
+
+                    for (int64_t j = 0; j < rk2; ++j) {
+                        const int64_t h = g*rk2 + j;
+
+                        const char * kq_th = (const char *) kq->data + s*nb03 + h*nb02 + t*nb00;
+
+                        for (int64_t i = 0; i < N; ++i) {
+                            const float a = *(const float *) (kq_th + i*nb01);
+                            ggml_vec_mad_f32((int) D, p + (h*N + i)*D, v32, a);
+                        }
+                    }
+                }
+            }
+        }
+
+        ggml_barrier(params->threadpool);
+
+        // dst[i][h][:] = sum over token chunks
+        for (int64_t s = 0; s < S; ++s) {
+            for (int64_t h = ith; h < Hq; h += nth) {
+                for (int64_t i = 0; i < N; ++i) {
+                    float * d_row = (float *) ((char *) dst->data + s*nb3 + h*nb2 + i*nb1);
+
+                    const float * p0 = partials + s*n_chunk*partial_plane + h*N*D + i*D;
+                    memcpy(d_row, p0, D * sizeof(float));
+
+                    // z = x + y, so the destination doubles as one operand
+                    for (int64_t chunk = 1; chunk < n_chunk; ++chunk) {
+                        const float * p = partials + s*n_chunk*partial_plane + chunk*partial_plane + h*N*D + i*D;
+                        ggml_vec_add_f32((int) D, d_row, d_row, p);
+                    }
+                }
+            }
+        }
+    } else {
+        // ---- mode two: prefill -------------------------------------------------------------
+        // tasks are (s, kv head group, query block). Each task owns a disjoint set of dst rows,
+        // so it can accumulate straight into dst - no partials, no wdata, no barrier.
+        // V[g] is rescanned once per query block; at ctx 8192 that working set is ~1.1 MB and
+        // stays in L2, and kq is read exactly once in total.
+        static constexpr int64_t IB = 32;
+
+        const int64_t n_ib   = (N + IB - 1) / IB;
+        const int64_t n_task = Hkv * n_ib * S;
+
+        for (int64_t task = ith; task < n_task; task += nth) {
+            const int64_t ib =  task % n_ib;
+            const int64_t g  = (task / n_ib) % Hkv;
+            const int64_t s  =  task / (n_ib * Hkv);
+
+            const int64_t i0 = ib * IB;
+            const int64_t i1 = MIN(i0 + IB, N);
+
+            for (int64_t j = 0; j < rk2; ++j) {
+                const int64_t h = g*rk2 + j;
+                for (int64_t i = i0; i < i1; ++i) {
+                    memset((char *) dst->data + s*nb3 + h*nb2 + i*nb1, 0, D * sizeof(float));
+                }
+            }
+
+            for (int64_t t = 0; t < T; ++t) {
+                const char * v_row = (const char *) v->data + s*nb13 + t*nb11 + g*nb12;
+                to_float(v_row, v32, D);
+
+                for (int64_t j = 0; j < rk2; ++j) {
+                    const int64_t h = g*rk2 + j;
+
+                    const char * kq_th = (const char *) kq->data + s*nb03 + h*nb02 + t*nb00;
+
+                    for (int64_t i = i0; i < i1; ++i) {
+                        const float a = *(const float *) (kq_th + i*nb01);
+                        ggml_vec_mad_f32((int) D, (float *) ((char *) dst->data + s*nb3 + h*nb2 + i*nb1), v32, a);
+                    }
+                }
+            }
+        }
+    }
+}
+
+void ggml_compute_forward_mul_mat_tq(const ggml_compute_params * params, ggml_tensor * dst) {
+    switch (dst->op_params[3]) {
+        case GGML_PREC_DEFAULT:
+        case GGML_PREC_F32:
+            {
+                ggml_compute_forward_mul_mat_tq_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("fatal error");
+            }
+    }
+}
