+// [CPU-SPEC][Spec 02] ---------------------------------------------------------------------------
+// Why this block exists:
+//   In decode, a GQA model maps several query heads to one kv head, but the f16 attention kernel
+//   loops  {for each q row} {for each token}  - so every query head of a kv group re-reads the
+//   whole K/V of that group. Measured KV traffic multiplier on this machine (ctx=8192, t=12):
+//     alpha ~ 2.2 for Qwen3-0.6B (GQA ratio 2), ~3.4 for Qwen3-4B / glm-edge-4b (ratio 4)
+//   at ctx=8192 this is what makes FA ~2x slower than the legacy attention path.
+//   Evidence: ctest/benchmark_results.md S12 and S12.7.
+//
+// The fix swaps the loop order inside a kv group: read each K/V row once, then hand it to every
+// query head of that group. KV traffic multiplier goes from the GQA ratio down to 1.
+//
+// Scope: pure single-row decode only (neq1 == 1 && neq3 == 1). Everything else falls back to the
+// unmodified kernel - the exact list is in the `use_gqa` predicate further down.
+// Roll back without recompiling: LLAMA_FA_GQA=0.
+// ----------------------------------------------------------------------------------------------
+
+// Upper bounds for the on-stack scratch used by the grouped kernel. These run on pool worker
+// threads, so we cap both the number of simultaneously live accumulators and their width instead
+// of using heap allocation on the hot path. Models beyond these bounds simply fall back.
+static constexpr int64_t FA_GQA_MAX_RK2  =    8; // max query heads per kv head (Qwen2/3-72B=8, Gemma=8)
+static constexpr int64_t FA_GQA_MAX_DV   =  256; // max value head dim
+static constexpr int64_t FA_GQA_MAX_QROW = 1024; // max bytes for one converted Q row (DK * widest vec_dot type)
+
+// Minimum context length for the grouped kernel to pay off. See the `use_gqa` predicate for the
+// measurement behind this number (ctx<=2048 is slower with grouping, ctx>=4096 is faster).
+static constexpr int64_t FA_GQA_MIN_TOKENS = 4096;
+
+static bool ggml_fa_gqa_enabled(void) {
+    // Read once, never on the hot path.
+    static const bool enabled = []() {
+        const char * env = getenv("LLAMA_FA_GQA");
+        return !(env && atoi(env) == 0);
+    }();
+    return enabled;
+}
+
+static inline size_t ggml_fa_gqa_row_bytes(const size_t n) {
+    return (n + 31) & ~(size_t) 31;
+}
+
+// The per-(query head, token) arithmetic of the f16 attention kernel, extracted verbatim from the
+// ic-loop of ggml_compute_forward_flash_attn_ext_f16_one_chunk(). Both that kernel and the grouped
+// kernel below call this single copy, so the two cannot drift apart. Do not "improve" anything in
+// here: reordering these operations changes rounding and breaks bit-exactness, which is the only
+// correctness check available on this machine (llama-perplexity segfaults here).
+static inline void ggml_fa_f16_step(
+        const int64_t DK, const int64_t DV,
+        const float scale, const float logit_softcap,
+        ggml_vec_dot_t kq_vec_dot, ggml_to_float_t v_to_float, const ggml_type v_type,
+        const char * k_data, const char * v_data, const ggml_fp16_t * Q_q, const float mv,
+        float * V32, float * VKQ32, ggml_fp16_t * VKQ16,
+        float & S, float & M) {
+
+    float s; // KQ value
+
+    kq_vec_dot(DK, &s, 0, k_data, 0, Q_q, 0, 1);
+
+    s = s*scale; // scale KQ value
+
+    if (logit_softcap != 0.0f) {
+        s = logit_softcap*tanhf(s);
+    }
+
+    s += mv; // apply mask
+
+    const float Mold = M;
+
+    float ms = 1.0f; // upon new higher max val, scale VKQ and KQ sum with this value
+    float vs = 1.0f; // post-softmax KQ value, expf(s - M)
+
+    if (v_type == GGML_TYPE_F16) {
+        if (s > M) {
+            // s is new maximum, ms < 1.0f, vs == expf(s - s) == 1.0f
+            M = s;
+            ms = expf(Mold - M);
+
+            // V = V*expf(Mold - M)
+            ggml_vec_scale_f16(DV, VKQ16, ms);
+        } else {
+            // no new maximum, ms == 1.0f, vs != 1.0f
+            vs = expf(s - M);
+        }
+
+        // V += v*expf(s - M)
+        ggml_vec_mad_f16(DV, VKQ16, (const ggml_fp16_t *) v_data, vs);
+    } else {
+        if (s > M) {
+            // s is new maximum, ms < 1.0f, vs == expf(s - s) == 1.0f
+            M = s;
+            ms = expf(Mold - M);
+
+            // V = V*expf(Mold - M)
+            ggml_vec_scale_f32(DV, VKQ32, ms);
+        } else {
+            // no new maximum, ms == 1.0f, vs != 1.0f
+            vs = expf(s - M);
+        }
+
+        // V += v*expf(s - M)
+        if (v_to_float) {
+            v_to_float(v_data, V32, DV);
+            ggml_vec_mad_f32(DV, VKQ32, V32, vs);
+        } else {
+            // V is F32
+            ggml_vec_mad_f32(DV, VKQ32, (const float *) v_data, vs);
+        }
+    }
+
+    S = S*ms + vs; // scale and increment sum with partial sum
+}
+
+// The per-query-head tail of the same kernel, also extracted verbatim: fp16 -> fp32 conversion of
+// the accumulator, sink token rescale, normalization and the final write (to dst or to partials).
+// Shared for the same reason as ggml_fa_f16_step().
+//   v is F16     -> VKQ32 is the fp32 scratch to write, VKQ16 holds the accumulated rows
+//   v is not F16 -> VKQ32 is the accumulator itself and VKQ16 is unused
+static inline void ggml_fa_f16_finalize(
+        ggml_tensor * dst, const int64_t DV, const ggml_type v_type,
+        const ggml_tensor * sinks, const bool apply_sinks,
+        const int64_t ir, const int iq1, const int iq2, const int iq3, const int h,
+        float * partials, const int64_t partial_stride,
+        float * VKQ32, const ggml_fp16_t * VKQ16, float & S, float & M) {
+
+    GGML_TENSOR_LOCALS(int64_t, ne, dst, ne)
+    GGML_TENSOR_LOCALS(size_t,  nb, dst, nb)
+
+    if (v_type == GGML_TYPE_F16) {
+        for (int64_t d = 0; d < DV; ++d) {
+            VKQ32[d] = GGML_CPU_FP16_TO_FP32(VKQ16[d]);
+        }
+    }
+
+    // sinks - apply only on the first kv-chunk
+    if (sinks && apply_sinks) {
+        const float s = ((float *)((char *) sinks->data))[h];
+
+        float ms = 1.0f;
+        float vs = 1.0f;
+
+        if (s > M) {
+            ms = expf(M - s);
+            M = s;
+            ggml_vec_scale_f32(DV, VKQ32, ms);
+        } else {
+            vs = expf(s - M);
+        }
+
+        S = S*ms + vs;
+    }
+
+    if (partials) {
+        // Write M, S, VKQ to partials for later reduction
+        // partials layout: [M, S, VKQ[DV]] per query head
+        float * partial = partials + ir * partial_stride;
+        partial[0] = M;
+        partial[1] = S;
+        memcpy(partial + 2, VKQ32, DV * sizeof(float));
+    } else {
+        // V /= S
+        const float S_inv = S == 0.0f ? 0.0f : 1.0f/S;
+        ggml_vec_scale_f32(DV, VKQ32, S_inv);
+
+        // dst indices
+        const int i1 = iq1;
+        const int i2 = iq2;
+        const int i3 = iq3;
+
+        // permute(0, 2, 1, 3)
+        memcpy((char *) dst->data + (i3*ne2*ne1 + i2 + i1*ne1)*nb1, VKQ32, nb1);
+    }
+}
