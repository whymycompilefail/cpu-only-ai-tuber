+// [CPU-SPEC] Spec 03: ggml_mul_mat_tq
+//
+//   dst[d,n,h,s] = sum_t kq[t,n,h,s] * to_float(v)[d,t,h/rk,s]     rk = Hq / Hkv
+//
+// same shape as ggml_mul_mat(ggml_cont(ggml_transpose(v)), kq), but V is consumed in the
+// flash-attn layout (head_dim innermost and contiguous), which is the only layout in which a
+// block-quantized V is addressable at all. see specs/legacy-quant-v-op.md §2.
+
+struct ggml_tensor * ggml_mul_mat_tq(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * kq,
+        struct ggml_tensor  * v) {
+    GGML_ASSERT(kq->type == GGML_TYPE_F32);
+    GGML_ASSERT(v->type  != GGML_TYPE_F32); // f16/bf16/quantized: anything with a to_float
+    GGML_ASSERT(!ggml_is_transposed(kq));
+    GGML_ASSERT(!ggml_is_transposed(v));
+
+    GGML_ASSERT(v->ne[3] == kq->ne[3]);
+    GGML_ASSERT(v->ne[1] == kq->ne[0]); // T (contracted dim)
+    GGML_ASSERT(v->ne[2] >  0);
+    GGML_ASSERT(kq->ne[2] % v->ne[2] == 0); // GQA broadcast: Hq % Hkv == 0
+
+    // the contracted dim of a block-quantized V is ne[0] (head_dim) in this op, so only the
+    // head_dim itself has to be block-aligned - the row stride is handled by the kernel
+    GGML_ASSERT(v->ne[0] % ggml_blck_size(v->type) == 0);
+
+    const int64_t ne[4] = { v->ne[0], kq->ne[1], kq->ne[2], kq->ne[3] };
+
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+
+    result->op     = GGML_OP_MUL_MAT_TQ;
+    result->src[0] = kq;
+    result->src[1] = v;
+
+    return result;
+}
